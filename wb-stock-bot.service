[Unit]
Description=Wildberries Stock Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wb-bot
Group=wb-bot
WorkingDirectory=/opt/wb-stock-bot
EnvironmentFile=/opt/wb-stock-bot/.env
ExecStart=/opt/wb-stock-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

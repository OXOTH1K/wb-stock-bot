# Единый персональный WB-токен с правами чтения и записи.
# Категории: Контент, Маркетплейс, Аналитика.
# Этот же токен используется для чтения данных и изменения остатков FBS.
WB_TOKEN=PASTE_WB_TOKEN_HERE

# Токен Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:PASTE_TELEGRAM_BOT_TOKEN_HERE

# Один или несколько chat_id через запятую.
# Если оставить пустым, запустите бота, отправьте /id и вставьте полученный ID сюда.
TELEGRAM_CHAT_IDS=

# Интервалы фоновой проверки (секунды).
FBS_CHECK_INTERVAL=300
WB_CHECK_INTERVAL=1800
CATALOG_REFRESH_INTERVAL=21600
ORDER_CHECK_INTERVAL=30

# Сколько товаров показывать на странице команды /stocks.
STOCKS_PAGE_SIZE=30

DB_PATH=./data/stocks.sqlite3
HTTP_TIMEOUT=30

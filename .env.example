# Единый персональный WB-токен с правами чтения и записи.
# Категории: Контент, Маркетплейс, Аналитика.
# Этот же токен используется для чтения данных и изменения остатков FBS.
WB_TOKEN=PASTE_WB_TOKEN_HERE

# Токен Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:PASTE_TELEGRAM_BOT_TOKEN_HERE

# Один или несколько chat_id через запятую.
# Если оставить пустым, запустите бота, отправьте /id и вставьте полученный ID сюда.
TELEGRAM_CHAT_IDS=

# Интервалы фоновой проверки (секунды).
FBS_CHECK_INTERVAL=300
WB_CHECK_INTERVAL=1800
CATALOG_REFRESH_INTERVAL=21600
ORDER_CHECK_INTERVAL=30

# OZON Seller API (необязательно).
# Если обе переменные пустые, OZON-интеграция отключена.
OZON_CLIENT_ID=
OZON_API_KEY=
# Если FBS/rFBS-склад OZON один, бот определит его автоматически.
# Если складов несколько, укажите warehouse_id нужного склада.
OZON_WAREHOUSE_ID=
OZON_ORDER_CHECK_INTERVAL=30
OZON_STOCK_CHECK_INTERVAL=300

# Сколько товаров показывать на странице команды /stocks.
STOCKS_PAGE_SIZE=30

DB_PATH=./data/stocks.sqlite3
HTTP_TIMEOUT=30

# Web CRM. Слушаем LAN-интерфейсы, но пропускаем только указанные CIDR.
CRM_ENABLED=1
CRM_HOST=0.0.0.0
CRM_PORT=8080
CRM_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,192.168.1.0/24

# Можно дополнительно включить Basic Auth.
# Если CRM_HOST не localhost и CRM_ALLOWED_NETWORKS пуст, логин/пароль обязательны.
CRM_USER=
CRM_PASSWORD=

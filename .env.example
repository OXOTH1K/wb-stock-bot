# Единый персональный WB-токен с правами чтения и записи.
# Категории: Контент, Маркетплейс, Аналитика; Статистика для поиска заказов WB в CRM.
# Этот же токен используется для чтения данных и изменения остатков FBS.
WB_TOKEN=PASTE_WB_TOKEN_HERE

# Токен Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:PASTE_TELEGRAM_BOT_TOKEN_HERE

# Один или несколько chat_id через запятую.
# Если оставить пустым, запустите бота, отправьте /id и вставьте полученный ID сюда.
TELEGRAM_CHAT_IDS=

# Необязательные Telegram custom emoji ID для значков WB/Ozon.
# Если оставить пустыми, бот использует Unicode fallback: 🟣 для WB и 🔵 для Ozon.
# Для custom emoji в сообщениях владелец бота должен иметь Telegram Premium
# (или бот должен иметь подходящее право через Fragment).
TELEGRAM_WB_EMOJI_ID=
TELEGRAM_OZON_EMOJI_ID=

# Интервалы фоновой проверки (секунды).
FBS_CHECK_INTERVAL=300
WB_CHECK_INTERVAL=1800
CATALOG_REFRESH_INTERVAL=21600
ORDER_CHECK_INTERVAL=30

# OZON Seller API (необязательно).
# Если обе переменные пустые, OZON-интеграция отключена.
OZON_CLIENT_ID=
OZON_API_KEY=
# Если FBS/rFBS-склад OZON один, бот определит его автоматически.
# Если складов несколько, укажите warehouse_id нужного склада.
OZON_WAREHOUSE_ID=
OZON_ORDER_CHECK_INTERVAL=30
OZON_STOCK_CHECK_INTERVAL=300

# Сколько товаров показывать на странице команды /stocks.
STOCKS_PAGE_SIZE=30

DB_PATH=./data/stocks.sqlite3
HTTP_TIMEOUT=30

# Web CRM. Авторизация обязательна, в том числе для localhost/LAN.
CRM_ENABLED=1
CRM_HOST=127.0.0.1
CRM_PORT=8080
CRM_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

# Задайте свои логин и уникальный пароль (для интернета минимум 20 символов).
# Не публикуйте эти значения. Без них включённая CRM не запустится.
CRM_USER=
CRM_PASSWORD=
# После появления домена deploy.sh --setup-caddy crm.example.ru заполнит URL.
# При публичном URL обязателен CRM_HOST=127.0.0.1 и доступ через HTTPS/Caddy.
CRM_PUBLIC_URL=
